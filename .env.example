# Local development only. Keep false for shared/hosted environments.
DEV_AUTH_ENABLED=false
NEXT_PUBLIC_USE_MOCK=false
# Server HMAC salt for login-rate keys and local dev sessions; use a long random value.
COCKPIT_AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server URL/anon-key overrides; otherwise NEXT_PUBLIC values are used.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TMAP_API_KEY=
KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
GEMINI_API_KEY=
# Optional integration providers (no fixture responses in production).
INCHEON_AIRPORT_API_KEY=
KAC_FLIGHT_API_KEY=
KAC_FLIGHT_API_ENDPOINT=
